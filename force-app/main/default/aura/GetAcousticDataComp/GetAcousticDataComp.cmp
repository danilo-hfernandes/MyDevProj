<aura:component implements="force:hasRecordId,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes" controller="GetEmailData" access="global">
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="emailMessages" type="List" />
    <aura:attribute name="selectedEmail" type="Object" />
    <aura:attribute name="isLoading" type="Boolean" default="true" />
    <aura:attribute name="currentPage" type="Integer" default="1" />
    <aura:attribute name="totalPages" type="Integer" default="1" />
    
    <aura:attribute name="columns" type="List" default="[{
                                                        label: 'Subject', fieldName: 'SilverpopSubject', type: 'text'
                                                        }, {
                                                        label: 'Acoustic Email Name', fieldName: 'Name', type: 'text'
                                                        }, {
                                                        label: 'Sent Date', fieldName: 'SilverpopSentDateTime', type: 'date'
                                                        }, {
                                                        label: 'Open Date/Time', fieldName: 'SilverpopOpenDateTime', type: 'date'
                                                        }, {
                                                        type: 'action', typeAttributes: { rowActions: [{ label: 'View', name: 'viewEmail' }] }
                                                        }]"/>
    
    <!-- Handles the init event -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Separator -->
    <hr />
    
    <lightning:card title="Marketing Email" iconName="standard:email">
        <aura:if isTrue="{!v.isLoading}">
            <lightning:spinner alternativeText="Loading emails..." />
        </aura:if>
        
        <aura:if isTrue="{!not(v.isLoading)}">
            <aura:if isTrue="{!empty(v.emailMessages)}">
                <p>No emails found for this record.</p>
                <aura:set attribute="else">
                    
                    <div class="slds-box slds-theme_default slds-m-bottom_medium">
                        <p class="slds-text-heading_small">Acoustic Email Activity</p>	
                        
                        <lightning:datatable
                                             data="{!v.emailMessages}"
                                             columns="{!v.columns}"
                                             keyField="Id"
                                             onrowaction="{!c.handleRowAction}" />
                        
                    </div>
                    
                </aura:set>
            </aura:if>
        </aura:if>
        
        
        <!-- Pagination Controls slds-m-top_medium-->
        <div class="slds-p-vertical_medium">
            <lightning:button label="Previous" onclick="{!c.previousPage}" disabled="{!v.currentPage == 1}" />
            <lightning:button label="Next" onclick="{!c.nextPage}" disabled="{!v.currentPage == v.totalPages}" />
            <p>Page {!v.currentPage} of {!v.totalPages}</p>
        </div>
        
        <!-- Separator -->
        <hr />
        
        <aura:if isTrue="{!not(empty(v.selectedEmail))}">
            <lightning:card title="Individual Email Result" >    <!-- iconName="standard:email"-->
                <div class="slds-box slds-theme_default">
                    
                    <div class="slds-grid slds-gutters slds-wrap">
                        <!-- Left Column -->
                        <div class="slds-col slds-size_1-of-2">
                            
                            <p>Acoustic Email Name:  {!v.selectedEmail.Name}</p>
                            <p>Email Name:  {!v.selectedEmail.SilverpopEmailName}</p>
                            <p>Subject:  {!v.selectedEmail.SilverpopSubject}</p>
                            <p>Sent Date/Time: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.SilverpopSentDateTime}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            <p>Opened:  {!v.selectedEmail.SilverpopOpened}</p>
                            
                        </div>                   
                        
                        <!-- Right Column -->
                        <div class="slds-col slds-size_1-of-2">             
                            
                            <p>Lead:  {!v.selectedEmail.SilverpopLead}</p>
                            <p>Contact:  {!v.selectedEmail.SilverpopContact}</p>
                            <p>Campaign:  {!v.selectedEmail.SilverpopEngage}</p>
                            <p>Acoustic_id:  {!v.selectedEmail.SilverpopSilverpopId}</p>
                            
                        </div> 
                    </div> 
                </div> 
                
            </lightning:card>             
            
            
            <lightning:card title="Delivery" >     <!-- iconName="standard:email"-->
                <div class="slds-box slds-theme_default">
                    <div class="slds-grid slds-gutters slds-wrap">
                        <!-- Left Column -->
                        <div class="slds-col slds-size_1-of-2">
                            
                            <p>Status:  {!v.selectedEmail.SilverpopStatus}</p>
                            <p>Open Date/Time: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.SilverpopOpenDateTime}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            
                        </div>                   
                        
                        <!-- Right Column -->
                        <div class="slds-col slds-size_1-of-2">             
                            
                            <p>Date Unsubscribed: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.SilverpopDateUnsubscribed}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            <p>Date Bounced: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.silverpopDateBounced}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            
                        </div> 
                    </div> 
                </div> 
                
            </lightning:card>     
            
            
            
            
            
            <lightning:card title="Additional Data" >
                <div class="slds-box slds-theme_default">
                    <div class="slds-grid slds-gutters slds-wrap">
                        <!-- Left Column -->
                        <div class="slds-col slds-size_1-of-2">
                            
                            <p>Created By Id:  {!v.selectedEmail.CreatedById}</p>
                            <p>Created Date: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.CreatedDate}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            <p>Id:  {!v.selectedEmail.Id}</p>
                            <p>Is Deleted:  {!v.selectedEmail.IsDeleted}</p>
                            
                            <p>Owner Id:  {!v.selectedEmail.OwnerId}</p>
                            
                            
                        </div>                   
                        
                        <!-- Right Column -->
                        <div class="slds-col slds-size_1-of-2">             
                            
                            <p>Last Modified By Id:  {!v.selectedEmail.LastModifiedById}</p>
                            <p>Last Modified Date: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.LastModifiedDate}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            <p>Last Referenced Date: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.LastReferencedDate}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            <p>Last Viewed Date: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.LastViewedDate}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>
                            <p>System Modstamp: 
                                <lightning:formattedDateTime 
                                                             value="{!v.selectedEmail.SystemModstamp}" 
                                                             year="numeric" 
                                                             month="short" 
                                                             day="2-digit" 
                                                             hour="2-digit" 
                                                             minute="2-digit" 
                                                             timeZoneName="short" />
                            </p>                            
                        </div> 
                    </div> 
                </div> 
                
            </lightning:card>              
            
            
            
            
            <!--  </div>  -->
            
            
            <!--            <div aura:id="emailBody" class="slds-box slds-theme_default slds-m-top_medium">  -->
            <!--                    <aura:unescapedHtml value="{!v.selectedEmail.HtmlBody}" />				-->
            <!--                </div>																		-->
            
            <!--  </lightning:card>  -->
            
        </aura:if>
    </lightning:card>
</aura:component>