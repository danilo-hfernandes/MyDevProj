<aura:component 
    controller="LuxuryExcursionController"
    implements="force:hasRecordId,flexipage:availableForRecordHome"
    access="global">

    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="excursionList" type="Luxury_Excursion__c[]"/>
    <aura:attribute name="isModalOpen" type="Boolean" default="false"/>
    <aura:attribute name="selectedRecordId" type="String"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <lightning:card title="Luxury Excursion History">

        <table class="slds-table slds-table_bordered slds-table_cell-buffer">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date/Time</th>
                    <th>Location</th>
                    <th>Cost</th>
                    <th>Edit</th>
                    <th>Add</th>
                </tr>
            </thead>
            <tbody>
                <aura:iteration items="{!v.excursionList}" var="exc">
                    <tr>
                        <td>{!exc.Name}</td>
                        <td>{!exc.Date_Time__c}</td>
                        <td>{!exc.Location__c}</td>
                        <td>{!exc.HSI_Cost__c}</td>

                        <td>
                            <lightning:button 
                                label="Edit"
                                variant="brand"
                                value="{!exc.Id}"
                                onclick="{!c.editRecord}"/>
                        </td>

                        <td>
                            <lightning:button 
                                label="ADD"
                                variant="brand"
                                value="{!exc.Id}"
                                onclick="{!c.addRecord}"/>
                        </td>
                    </tr>
                </aura:iteration>
            </tbody>
        </table>

    </lightning:card>

</aura:component>