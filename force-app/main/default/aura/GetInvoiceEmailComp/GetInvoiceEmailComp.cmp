<aura:component implements="force:hasRecordId,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes" controller="GetEmailData" access="global">
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="emailMessages" type="List" />
    <aura:attribute name="selectedEmail" type="Object" />
    <aura:attribute name="isLoading" type="Boolean" default="true" />
    <aura:attribute name="currentPage" type="Integer" default="1" />
    <aura:attribute name="totalPages" type="Integer" default="1" />
    
    <aura:attribute name="columns" type="List" default="[{
                                                        label: 'Member Name', fieldName: 'MemberName', type: 'text'
                                                        }, {
                                                        label: 'Affiliate Name', fieldName: 'AffiliateName', type: 'text'
                                                        }, {
                                                        label: 'Send Date', fieldName: 'SendDate', type: 'date'
                                                        }, {
                                                        type: 'action', typeAttributes: { rowActions: [{ label: 'View', name: 'viewEmail' }] }
                                                        }]"/>
    
    <!-- Handles the init event -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <!-- Separator -->
    <hr />
    
    <lightning:card title="Invoices" iconName="standard:email">
        <aura:if isTrue="{!v.isLoading}">
            <lightning:spinner alternativeText="Loading emails..." />
        </aura:if>
        
        <aura:if isTrue="{!not(v.isLoading)}">
            <aura:if isTrue="{!empty(v.emailMessages)}">
                <p>No emails found for this record.</p>
                <aura:set attribute="else">
                    
                    <div class="slds-box slds-theme_default slds-m-bottom_medium">
                        <p class="slds-text-heading_small">Invoices</p>	
                        
                        <lightning:datatable
                                             data="{!v.emailMessages}"
                                             columns="{!v.columns}"
                                             keyField="Id"
                                             onrowaction="{!c.handleRowAction}" />
                        
                    </div>
                    
                </aura:set>
            </aura:if>
        </aura:if>
        
        
        <!-- Pagination Controls slds-m-top_medium-->
        <div class="slds-p-vertical_medium">
            <lightning:button label="Previous" onclick="{!c.previousPage}" disabled="{!v.currentPage == 1}" />
            <lightning:button label="Next" onclick="{!c.nextPage}" disabled="{!v.currentPage == v.totalPages}" />
            <p>Page {!v.currentPage} of {!v.totalPages}</p>
        </div>
        
        <!-- Separator -->
        <hr />
        
        <aura:if isTrue="{!not(empty(v.selectedEmail))}">
            <lightning:card title="Details" >    <!-- iconName="standard:email"-->
                <div class="slds-box slds-theme_default">
                    
                    
                    <p>Member Name:  {!v.selectedEmail.MemberName}</p>
                    <p>Affiliate Name:  {!v.selectedEmail.AffiliateName}</p>
                    <p>Member Number:  {!v.selectedEmail.MemberNumber}</p>
                    <p>Annual Dues Invoice Mailed to Member - Approximate Mailling Date:  {!v.selectedEmail.SendDate}</p>
                    
                    <!-- Separator -->
                    <hr />
                    
                    <p>Membership Status:  {!v.selectedEmail.MembershipStatus}</p>
                    <p>Preferred Language:  {!v.selectedEmail.PreferredLanguage}</p>
                    <p>Annual Dues:  {!v.selectedEmail.AnnualDues}</p>
                    <p>Due Date:  {!v.selectedEmail.DueDate}</p>
                    <p>Web Address:  {!v.selectedEmail.WebAddress}</p>                   
                    <p>QR Code Link:  {!v.selectedEmail.QRCodeLink}</p>

                    <!-- Separator -->
                    <!--   <hr />  -->
                    
                    <!-- 
                      MarketingBrand
                      ParentBrand
                      Logo
                      MembershipSubType
                      Address
                      City
                      State
                      Country
                      ZipCode
					-->
                    
                </div> 
                
            </lightning:card>             
            
            
            
        </aura:if>
    </lightning:card>
</aura:component>