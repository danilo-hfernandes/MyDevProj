<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" controller="HookedQualificationTabController" access="global" >
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="isSaveDisabled" type="Boolean" default="false" />
    <aura:attribute name="recordTypeName" type="String" />
    <aura:attribute name="isRequired" type="Boolean" default="false" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <!-- Display section header -->
    <lightning:card title="Qualifications" iconName="utility:check">
        
        
        <lightning:recordEditForm                                      
                                  aura:id="recordEditForm"
                                  recordId="{!v.recordId}"
                                  objectApiName="Opportunity"
                                  onsubmit="{!c.handleSave}"
                                  onsuccess="{!c.handleSuccess}"
                                  onerror="{!c.handleError}">
            
            <!-- Display picklist fields -->
            
            
            
            <div class="slds-grid slds-gutters">
                <div class="slds-col">
                    <lightning:inputField fieldName="Marital_Status__c"  />
                    <lightning:inputField fieldName="Age_Range__c"  />
                </div>
                <div class="slds-col">
                    <lightning:inputField fieldName="Major_Credit_Card__c"  />
                    <lightning:inputField fieldName="Household_Income__c"  />   
                </div>
            </div>
            
        </lightning:recordEditForm>
        
        
        <!-- Save button -->
        <div class="slds-m-top_medium">
            <lightning:button onclick="{!c.handleSave}" label="Save" variant="brand" type="submit" disabled="{!v.isSaveDisabled}" />
        </div>
    </lightning:card>
</aura:component>