<aura:component controller="PostPaymentController" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="showModal" type="Boolean" default="false"/>
    <aura:attribute name="payment" type="Payment__c" />
    <aura:attribute name="recordTypeId" type="Id" />
    <aura:attribute name="isLoading" type="Boolean" default="false"/>
    <aura:attribute name="selectedMethod" type="String" default="" />
    
    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
        <aura:if isTrue="{!v.showModal}">
        <section role="dialog" tabindex="-1" class="slds-modal slds-fade-in-open">
            <aura:if isTrue="{!v.isLoading}">
                <lightning:spinner alternativeText="Loading..." size="medium" variant="brand" />
            </aura:if>
            <div class="slds-modal__container">
                <header class="slds-modal__header">
                    <h2 class="slds-text-heading_medium">New Payment</h2>
                </header>


                <!-- Payment Method Picklist -->
                <aura:if isTrue="{!empty(v.selectedMethod)}">
                    <div class="slds-modal__content slds-p-around_medium">
                        <lightning:select label="Payment Method" value="{!v.selectedMethod}" onchange="{!c.onMethodChange}">
                            <option value="">--None--</option>
                            <option value="Credit Card In Person">Credit Card In Person</option>
                            <option value="Clarity Pay">Clarity Pay</option>
                        </lightning:select>
                    </div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral" label="Cancel" onclick="{!c.cancel}" />
                    </footer>                    
                </aura:if>
                
                <!-- Render form if a method is selected -->
                <aura:if isTrue="{!not(empty(v.selectedMethod))}">                
                
                    <div class="slds-modal__content slds-p-around_medium">
                        <lightning:input label="Payment Amount" value="{!v.payment.Payment_Amount__c}" required="true" type="number" min="0" step="0.01" disabled="isLoading"/>
                        <lightning:input label="Transaction ID/Reference" value="{!v.payment.AuthorizeNet_Transaction_Id__c}" disabled="isLoading"/>
                        <lightning:input label="Paid On" value="{!v.payment.Paid_On__c}" disabled="true"/>
                        <lightning:input label="Payment Type" value="{!v.payment.Payment_Type__c}" disabled="true"/>
                        <lightning:input label="Payment Method" value="{!v.payment.Payment_Method__c}" disabled="true"/>
                        <lightning:input label="Product ID" value="{!v.payment.Product_Id__c}" disabled="true"/>
                    </div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral" label="Cancel" onclick="{!c.cancel}" />
                        <lightning:button variant="brand" label="Submit" onclick="{!c.submit}" />
                    </footer>
                    
                </aura:if>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
    
</aura:component>